# ──────────────────────────────────────────
# Builder
# ──────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_NO_DEV=1 UV_PYTHON_DOWNLOADS=0

WORKDIR /backend

# Install dependencies before copying source — reruns only when lockfile changes
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --extra api

# Copy only the source files the API needs
COPY ./app/ /backend/app/
COPY pyproject.toml uv.lock /backend/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra api

# ──────────────────────────────────────────
# Runner
# ──────────────────────────────────────────
FROM python:3.12-slim-bookworm AS runner

RUN groupadd --system --gid 999 nonroot \
 && useradd --system --gid 999 --uid 999 --create-home nonroot

COPY --from=builder --chown=nonroot:nonroot /backend /backend

ENV PATH="/backend/.venv/bin:$PATH"
ENV PYTHONPATH="/backend/app/"
ENV PYTHONUNBUFFERED=1

USER nonroot
WORKDIR /backend

# ──────────────────────────────────────────
# Dev — hot reload via volume mount
# ──────────────────────────────────────────
FROM runner AS dev
CMD ["fastapi", "dev", "/backend/app/main.py", "--host", "0.0.0.0", "--port", "8000"]

# ──────────────────────────────────────────
# Prod
# ──────────────────────────────────────────
FROM runner AS prod
CMD ["fastapi", "run", "/backend/app/main.py", "--host", "0.0.0.0", "--port", "8000"]
